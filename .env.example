# Copy this file to .env and replace placeholders with your own values.
# Never commit .env or real credentials.

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

# M-Pesa configuration
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="YOUR_CONSUMER_KEY"
MPESA_CONSUMER_SECRET="YOUR_CONSUMER_SECRET"
MPESA_SHORTCODE="YOUR_SHORTCODE"
MPESA_PASSKEY="YOUR_PASSKEY"
MPESA_CALLBACK_URL="https://your-domain.example/api/mpesa/callback"
MPESA_TRANSACTION_TYPE="YOUR_TRANSACTION_TYPE"
MPESA_BOOKING_DEPOSIT="YOUR_DEPOSIT_AMOUNT"
